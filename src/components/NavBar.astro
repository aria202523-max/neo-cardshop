---
import { LINE_URL } from "../data/site-config.js";

interface Props {
  current: "top" | "shop-info" | "kaitorihyo" | "takuhai" | "zaiko" | "jisseki" | "contact";
}
const { current } = Astro.props;

const items: { key: Props["current"]; label: string; href: string }[] = [
  { key: "top", label: "トップ", href: "/" },
  { key: "shop-info", label: "店舗情報", href: "/#shop-info" },
  { key: "kaitorihyo", label: "買取表", href: "/kaitorihyo/" },
  { key: "takuhai", label: "宅配買取", href: "/takuhai-kaitori/" },
  { key: "zaiko", label: "在庫", href: "/zaiko/" },
  { key: "jisseki", label: "買取実績", href: "/jisseki/" },
  { key: "contact", label: "お問い合わせ", href: LINE_URL },
];
---

<nav class="nav-bar">
  <ul class="nav-list">
    {items.map((item) => (
      <li class={item.key === current ? "current" : undefined}>
        <a href={item.href}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-bar { background: var(--ink); border-radius: 8px; overflow: hidden; }
  .nav-list { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  .nav-list li { flex: 1 1 auto; }
  .nav-list a {
    display: block; width: 100%; box-sizing: border-box; border-right: 1px solid var(--line);
    color: var(--paper); font-weight: 700; font-size: 13px; padding: 13px 8px; cursor: pointer;
    text-align: center; text-decoration: none;
  }
  .nav-list li:last-child a { border-right: none; }
  .nav-list a:hover { filter: brightness(1.6); }
  :root[data-theme="dark"] .nav-list a:hover { filter: brightness(0.8); }
  .nav-list .current a { position: relative; }
  .nav-list .current a::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: 4px; height: 2px; background: var(--paper); }

  @media (max-width: 560px) {
    .nav-list a { font-size: 11px; padding: 11px 4px; }
  }
</style>
