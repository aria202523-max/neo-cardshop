---
interface PriceRow {
  name: string;
  tag: { type: "graded"; label: string } | { type: "retro" };
  price: string;
  diff?: string;
  image?: string;
}

interface Props {
  title: string;
  updated: string;
  rows: PriceRow[];
}
const { title, updated, rows } = Astro.props;
---

<div class="price-card">
  <div class="price-card-head">
    <span>{title}</span>
    <span class="mono" style="font-weight:400; opacity:.85;">{updated}</span>
  </div>
  {rows.map((row) => (
    <div class="price-row">
      <div class="price-thumb">
        {row.image ? (
          <img src={row.image} alt={row.name} width="52" height="52" />
        ) : (
          <span class="price-thumb-empty">PHOTO</span>
        )}
      </div>
      <div>
        <div class="price-row-name">{row.name}</div>
        <div class="price-row-sub">
          {row.tag.type === "graded" ? (
            <span class="slab-tag"><span class="bar"></span><span class="label">{row.tag.label}</span></span>
          ) : (
            <span class="tag-retro">RETRO</span>
          )}
        </div>
      </div>
      <div class="price-stack">
        <div class="price-value mono">{row.price}</div>
        <div class="price-diff-up mono">{row.diff ?? ""}</div>
      </div>
    </div>
  ))}
</div>
