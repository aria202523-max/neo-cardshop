---
import { CATEGORIES } from "../data/categories.js";
const items = [
  ...CATEGORIES.map((c) => c.label),
  "鑑定品・レトロカードならNEO",
  "宅配買取も受付中",
];
---

<div class="ticker-bar">
  <div class="ticker-track">
    {items.map((item) => (
      <>
        <span>★</span>{item}
      </>
    ))}
    {items.map((item) => (
      <>
        <span>★</span>{item}
      </>
    ))}
  </div>
</div>

<style>
  .ticker-bar { background: var(--ink); color: var(--paper); overflow: hidden; white-space: nowrap; padding: 9px 0; }
  .ticker-track {
    display: inline-flex; gap: 36px; font-size: 13px; font-weight: 700; letter-spacing: 0.02em;
    animation: ticker 26s linear infinite;
  }
  .ticker-track span { opacity: 0.55; }
  @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; overflow-x: auto; }
  }
</style>
