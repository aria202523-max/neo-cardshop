---
import { CATEGORIES } from "../data/categories.js";
const extraCategories = ["鑑定品(PSA/BGS)", "レトロカード"];
---

<aside class="category-list">
  <div class="category-list-head">カテゴリー</div>
  {CATEGORIES.map((c) => <button type="button">{c.label}</button>)}
  {extraCategories.map((category) => <button type="button">{category}</button>)}
</aside>

<style>
  .category-list { border-radius: 10px; overflow: hidden; border: 1px solid var(--line); align-self: start; }
  .category-list-head { background: var(--ink); color: var(--paper); font-weight: 900; padding: 12px 16px; font-size: 14px; }
  .category-list button {
    display: block; width: 100%; text-align: left; padding: 12px 16px; font-size: 13px; font-weight: 700;
    border: none; border-top: 1px solid var(--line); background: var(--paper-raised); cursor: pointer; color: var(--ink);
  }
  .category-list button:hover { background: var(--line); }

  @media (max-width: 860px) {
    .category-list { display: none; }
  }
</style>
