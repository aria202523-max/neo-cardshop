---
interface Props {
  variant: "plain" | "premium";
  title: string;
  subtitle: string;
}
const { variant, title, subtitle } = Astro.props;
---

<div class={`promo-banner promo-${variant}`}>
  {title}
  <small>{subtitle}</small>
</div>

<style>
  .promo-banner { border-radius: 10px; padding: 20px 24px; text-align: center; font-weight: 900; font-size: 17px; margin-bottom: 16px; border: 2px solid var(--ink); }
  .promo-plain { background: var(--paper-raised); color: var(--ink); }
  .promo-plain small { color: var(--ink-soft); }
  .promo-premium { background: var(--ink); color: var(--paper); }
  .promo-premium small { color: var(--paper); opacity: 0.75; }
  .promo-banner small { display: block; font-size: 12px; font-weight: 700; margin-top: 4px; }
</style>
