---
---

<div class="brand-row">
  <div class="logo-lockup">
    <span class="logo-tag">トレーディングカードショップ</span>
    <div class="logo-brand-line">
      <span class="logo-avatar-frame">
        <img class="logo-photo" src="/images/mascot-neo-chan.jpg" alt="NEO公式キャラクター" width="46" height="46" />
      </span>
      <img class="logo-mark-img" src="/images/logo-neo.png" alt="trading card shop NEO" />
    </div>
  </div>
  <div class="cta-blocks">
    <a class="cta-block cta-buy" href="/zaiko/"><span class="small">トレカを</span><span class="big">買う</span></a>
    <a class="cta-block cta-sell" href="/takuhai-kaitori/"><span class="small">トレカを</span><span class="big">売る</span></a>
    <a class="cta-block cta-stock" href="/kaitorihyo/"><span class="small">今日の</span><span class="big">買取表</span></a>
  </div>
</div>

<style>
  .brand-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 18px; padding: 20px 0; }
  .logo-lockup { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .logo-tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    background: var(--paper-raised); border: 1px solid var(--line); border-radius: 4px; padding: 3px 8px;
  }
  .logo-brand-line { display: flex; align-items: center; gap: 10px; }
  .logo-avatar-frame {
    position: relative; width: 46px; height: 46px; border-radius: 50%; overflow: hidden;
    border: 2px solid var(--ink); flex: 0 0 auto; background: #fff;
  }
  /* the source badge photo has generous black margin around the white circle art;
     scale + center-crop so only the character fills the frame */
  .logo-photo {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; transform: scale(1.5); transform-origin: center;
  }
  .logo-mark-img { height: 56px; width: auto; display: block; border-radius: 4px; }

  .cta-blocks { display: flex; gap: 10px; flex-wrap: wrap; }
  .cta-block { display: block; flex: 1 1 150px; text-align: center; padding: 12px 14px; border-radius: 8px; cursor: pointer; text-decoration: none; }
  .cta-block .big { display: block; font-weight: 900; font-size: 18px; }
  .cta-block .small { display: block; font-size: 10px; letter-spacing: 0.08em; opacity: 0.85; margin-bottom: 2px; }
  .cta-buy { background: var(--ink); color: var(--paper); border: 2px solid var(--ink); }
  .cta-sell { background: var(--paper-raised); color: var(--ink); border: 2px solid var(--ink); }
  .cta-stock { background: var(--paper); color: var(--ink); border: 2px dashed var(--ink); }
  .cta-block:hover { filter: brightness(0.94); }
  .cta-block:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }

  @media (max-width: 560px) {
    .brand-row { flex-direction: column; align-items: stretch; }
    .cta-blocks { width: 100%; }
  }
</style>
