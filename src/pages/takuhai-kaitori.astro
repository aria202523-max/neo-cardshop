---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LINE_URL } from "../data/site-config.js";

const steps = [
  {
    title: "LINE公式アカウントを友だち追加",
    body: "下のボタンからNEOのLINE公式アカウントを友だち追加し、トークでご連絡ください。",
  },
  {
    title: "カードの写真・状態を送る",
    body: "お売りいただきたいカードの写真と状態を、LINEのトークで送ってください。簡易査定の目安をお伝えします。",
  },
  {
    title: "梱包・発送",
    body: "発送方法をLINEでご案内します。案内に沿ってカードを梱包し、発送してください。",
  },
  {
    title: "ご入金 または カードの返却",
    body: "到着後に正式査定を行い、結果をLINEでご連絡します。ご了承いただければ指定口座へお振込みします。ご了承いただけない場合はカードを返送します(送料はお客様負担となります)。",
  },
];
---

<BaseLayout
  title="宅配買取のご案内 | trading card shop NEO"
  description="NEOの宅配買取のご案内。LINE公式アカウントでのやり取りから、ご入金までの流れをご案内します。"
  current="takuhai"
>
  <div class="page-head">
    <h1 class="display">宅配買取のご案内</h1>
    <p class="lead">店頭にお越しいただかなくても、LINEでのやり取りだけでカードの買取査定を受けられます。鑑定品・レトロカードも歓迎です。</p>
  </div>

  <a class="line-btn display" href={LINE_URL} target="_blank" rel="noopener noreferrer">
    LINE公式アカウントを友だち追加する
  </a>

  <ol class="steps">
    {steps.map((step, i) => (
      <li class="step">
        <span class="step-num mono">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <div class="step-title">{step.title}</div>
          <p class="step-body">{step.body}</p>
        </div>
      </li>
    ))}
  </ol>

  <p class="jisseki-link">
    これまでの<a href="/jisseki/">買取実績</a>もご紹介しています。あわせてご覧ください。
  </p>

  <Fragment slot="footer">
    宅配買取のやり取りはLINE公式アカウントで行います。査定・発送方法などのご案内もLINEでお送りします。
  </Fragment>
</BaseLayout>

<style>
  .page-head { padding: 28px 0 18px; }
  .page-head h1 { font-size: clamp(24px, 3.4vw, 34px); margin: 0 0 6px; }
  .lead { font-size: 14px; color: var(--ink-soft); max-width: 60ch; margin: 0; }

  .line-btn {
    display: inline-block; margin: 8px 0 40px; padding: 16px 32px; border-radius: 999px;
    background: var(--ink); color: var(--paper); font-size: 16px; text-decoration: none;
  }
  .line-btn:hover { filter: brightness(0.9); }

  .steps { list-style: none; margin: 0 0 32px; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .step { display: flex; gap: 16px; align-items: flex-start; }
  .step-num {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--paper);
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;
  }
  .step-title { font-weight: 700; font-size: 15px; margin-bottom: 4px; }
  .step-body { margin: 0; font-size: 13px; color: var(--ink-soft); max-width: 60ch; }

  .jisseki-link { font-size: 13px; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 24px; }
  .jisseki-link a { color: var(--ink); }
</style>
