---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES } from "../data/categories.js";
---

<BaseLayout
  title="買取表 | trading card shop NEO"
  description="NEOの買取表。ポケモンカード・遊戯王・ワンピースカードゲームなど、ジャンル別に買取価格を確認できます。"
  current="kaitorihyo"
>
  <div class="page-head">
    <h1 class="display">買取表</h1>
    <div class="updated" id="updatedLabel">読み込み中…</div>
  </div>

  <div class="highlight-block">
    <div class="highlight-head">
      <h2 class="display">ピックアップ買取</h2>
    </div>
    <div class="pickup-carousel">
      <div class="pickup-track" id="pickupGrid"></div>
      <button class="pickup-nav pickup-prev" type="button" aria-label="前の画像">‹</button>
      <button class="pickup-nav pickup-next" type="button" aria-label="次の画像">›</button>
    </div>
    <div class="pickup-dots" id="pickupDots"></div>
  </div>

  <div class="toolbar">
    <div class="search-box">
      <span class="icon" aria-hidden="true"></span>
      <input type="text" id="cardSearch" placeholder="カード名で検索(例: リザードン、ブラック・ロータス)" autocomplete="off" />
    </div>
    <div class="chip-filter" id="catFilter">
      <button class="active" data-cat="all" type="button">すべて</button>
      {CATEGORIES.map((c) => (
        <button data-cat={c.key} type="button">{c.label}</button>
      ))}
    </div>
  </div>

  <div class="highlight-block">
    <div class="highlight-head">
      <h2 class="display">注目の高額買取</h2>
      <span>今週特に強化中のカード</span>
    </div>
    <div class="highlight-grid" id="highlightGrid"></div>
  </div>

  <div id="catalog"></div>

  <div class="empty-state" id="emptyState">該当するカードが見つかりませんでした。カテゴリーやキーワードを変えてお試しください。</div>

  <Fragment slot="footer">
    実データは店舗のGoogleスプレッドシートと連携し、自動反映されます。カテゴリー絞り込み・カード名検索はページ上で動作します。
  </Fragment>
</BaseLayout>

<script>
  import { initKaitorihyoPage } from "../scripts/kaitorihyo.js";
  initKaitorihyoPage(document);
</script>

<style>
  .page-head { padding: 28px 0 18px; }
  .page-head h1 { font-size: clamp(24px, 3.4vw, 34px); margin: 0 0 6px; }
  .page-head .updated { font-size: 13px; color: var(--ink-soft); }

  .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding: 6px 0 22px; }
  .search-box { position: relative; flex: 1 1 260px; }
  .search-box input {
    width: 100%; padding: 12px 16px 12px 40px; border-radius: 8px; border: 2px solid var(--ink);
    background: var(--surface); color: var(--ink); font-size: 14px;
  }
  .search-box input::placeholder { color: var(--ink-soft); }
  .search-box .icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; border: 2px solid var(--ink-soft); border-radius: 50%; }
  .search-box .icon::after { content: ""; position: absolute; width: 7px; height: 2px; background: var(--ink-soft); right: -7px; bottom: 1px; transform: rotate(45deg); }

  .chip-filter { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip-filter button {
    padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper-raised);
    color: var(--ink); font-weight: 700; font-size: 13px; cursor: pointer;
  }
  .chip-filter button.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip-filter button:hover:not(.active) { border-color: var(--ink); }

  .highlight-block { padding: 8px 0 36px; }
  .highlight-block.is-empty { display: none; }
  .highlight-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
  .highlight-head h2 { font-size: 18px; margin: 0; }
  .highlight-head span { font-size: 12px; color: var(--ink-soft); }
  .highlight-grid { display: flex; flex-direction: column; gap: 20px; }
  .highlight-grid :global(.highlight-card) {
    min-height: 160px; border-radius: 12px; overflow: hidden;
    background: var(--paper-raised); border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center;
  }
  .highlight-grid :global(.highlight-card img) { display: block; width: 100%; height: auto; }
  .highlight-grid :global(.highlight-empty) { font-size: 12px; font-weight: 700; color: var(--ink-soft); }

  /* ---- pickup carousel ---- */
  .pickup-carousel { position: relative; }
  .pickup-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    border-radius: 12px; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .pickup-track::-webkit-scrollbar { display: none; }
  .pickup-track :global(.highlight-card) {
    flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; min-height: 200px; border-radius: 12px; overflow: hidden;
    background: var(--paper-raised); border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center;
  }
  .pickup-track :global(.highlight-card img) { display: block; width: 100%; height: auto; }
  .pickup-track :global(.highlight-empty) { font-size: 12px; font-weight: 700; color: var(--ink-soft); }
  .pickup-nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--ink);
    background: var(--paper); color: var(--ink); font-size: 20px; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .pickup-nav:hover { filter: brightness(0.94); }
  .pickup-prev { left: 10px; }
  .pickup-next { right: 10px; }
  .pickup-carousel.is-single .pickup-nav { display: none; }
  .pickup-dots { display: flex; gap: 6px; justify-content: center; margin-top: 12px; }
  .pickup-dots button {
    width: 8px; height: 8px; border-radius: 50%; background: var(--line); border: none; padding: 0; cursor: pointer;
  }
  .pickup-dots button.active { background: var(--ink); }

  #catalog :global(.cat-group) { padding-bottom: 36px; }
  #catalog :global(.cat-group-head) {
    display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 2px solid var(--ink); margin-bottom: 2px;
  }
  #catalog :global(.cat-group-head h2) { font-size: 17px; margin: 0; }
  #catalog :global(.cat-group-head .count) { font-size: 12px; color: var(--ink-soft); }

  #catalog :global(.price-table-scroll) { overflow-x: auto; border: 1px solid var(--line); border-radius: 0 0 12px 12px; }
  #catalog :global(.price-table) {
    width: 100%; min-width: 480px; border-collapse: collapse; background: var(--surface);
  }
  #catalog :global(.price-table thead th) {
    background: var(--ink); color: var(--paper); font-size: 12px; font-weight: 900;
    text-align: left; padding: 10px 14px; white-space: nowrap;
  }
  #catalog :global(.price-table th.pt-th-price),
  #catalog :global(.price-table th.pt-th-date) { text-align: right; }
  #catalog :global(.price-table tbody td) {
    padding: 12px 14px; border-top: 1px solid var(--line); vertical-align: middle;
  }
  #catalog :global(.price-table tbody tr:first-child td) { border-top: none; }
  #catalog :global(.pt-row.is-hidden) { display: none; }

  #catalog :global(.pt-thumb) {
    width: 44px; height: 44px; border-radius: 6px; overflow: hidden; background: var(--paper-raised);
    border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;
  }
  #catalog :global(.pt-thumb img) { width: 100%; height: 100%; object-fit: cover; }
  #catalog :global(.pt-thumb-empty) { font-size: 8px; font-weight: 700; color: var(--ink-soft); }
  #catalog :global(.pt-name) { font-size: 14px; font-weight: 700; }
  #catalog :global(.pt-sub) { margin-top: 6px; }
  #catalog :global(.pt-price) { text-align: right; font-size: 16px; font-weight: 900; white-space: nowrap; }
  #catalog :global(.pt-date) { text-align: right; font-size: 12px; color: var(--ink-soft); white-space: nowrap; }

  .empty-state { text-align: center; padding: 48px 0; color: var(--ink-soft); font-size: 14px; display: none; }
  .empty-state.show { display: block; }
</style>
